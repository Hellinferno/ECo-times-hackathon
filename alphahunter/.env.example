# ============================================================
# AlphaHunter AI — Environment Configuration
# Copy this file to .env and fill in your values.
#
# NOTE: Scan/signal parameters (thresholds, intervals, etc.)
# are stored in the database SystemSettings table and can be
# adjusted live via the /api/settings endpoint — they do NOT
# come from environment variables.
# ============================================================

# Application
APP_ENV=development          # Set to "production" on Railway/cloud deploys

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: full connection URL (recommended for Railway/cloud)
DATABASE_URL=

# Option B: component-based (used if DATABASE_URL is blank)
DB_USER=alphahunter
DB_PASSWORD=alpha123
DB_NAME=alphahunter_dev
DB_HOST=localhost
DB_PORT=5432

# ── Redis ──────────────────────────────────────────────────────────────────────
# Option A: full URL (recommended for Upstash / Railway Redis)
REDIS_URL=

# Option B: component-based
REDIS_HOST=localhost
REDIS_PORT=6379

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list. Wildcard subdomain patterns (https://*.vercel.app) supported.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app

# ── LLM — Google Gemini ───────────────────────────────────────────────────────
# Free tier available at https://aistudio.google.com
# App works without a key but reasoning will use template fallback text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECS=30

# ── External Web Intelligence — TinyFish / Mino ────────────────────────────────
# Optional. Provides news, social, insider, and macro signals.
# Without this key the pipeline runs in legacy mode (3 signals only).
MINO_API_KEY=
TINYFISH_RUN_SSE_URL=https://mino.ai/v1/automation/run-sse
TINYFISH_DEFAULT_TIMEOUT_SECS=20

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# IMPORTANT: Change AUTH_JWT_SECRET before deploying to production.
# A warning is logged at startup if you are in production with the default value.
AUTH_JWT_SECRET=alphahunter-demo-jwt-secret-change-me
AUTH_JWT_EXPIRE_MINUTES=480
AUTH_DEMO_PASSWORD=AlphaHunter-demo-2026!
AUTH_DEMO_ORG_SLUG=alphahunter-labs
AUTH_DEMO_ORG_NAME=AlphaHunter Labs

# ── Alerts — Telegram (optional) ──────────────────────────────────────────────
# BUY signals are delivered to this Telegram chat when configured.
# Create a bot at https://t.me/BotFather, then get your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Local Vite dev uses /api proxied by vite.config.ts — leave as /api.
# For Vercel + Railway deploys, set to your Railway backend URL:
#   VITE_API_BASE_URL=https://your-backend.up.railway.app/api
VITE_API_BASE_URL=/api

# ── Misc ──────────────────────────────────────────────────────────────────────
WORLDMONITOR_API_URL=
