# ============================================================
# AlphaHunter AI - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Application
APP_ENV=development
APP_NAME=AlphaHunter AI
APP_VERSION=1.0.0
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# Database
DB_USER=alphahunter
DB_PASSWORD=alpha123
DB_NAME=alphahunter_dev
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=

# Gemini (LLM)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MINO_API_KEY=your_mino_api_key_here
TINYFISH_RUN_SSE_URL=https://mino.ai/v1/automation/run-sse
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECS=30

# Data Sources
YFINANCE_CACHE_TTL_LIVE=300
YFINANCE_CACHE_TTL_HISTORICAL=86400
NSE_BULK_DEALS_URL=https://www.nseindia.com/api/corporates-bulk-deals
NSE_REQUEST_TIMEOUT=15

# Scan Configuration
SCAN_INTERVAL_MINUTES=15
SCAN_MARKET_HOURS_START=09:15
SCAN_MARKET_HOURS_END=15:30
SCAN_PARALLEL_WORKERS=4
SCAN_STOCK_UNIVERSE_SIZE=100

# Signal Parameters
BREAKOUT_LOOKBACK_DAYS=30
VOLUME_SPIKE_THRESHOLD=2.0
VOLUME_AVG_PERIOD=20
BULK_DEAL_LOOKBACK_DAYS=5

# Decision Engine
CONFIDENCE_BUY_THRESHOLD=70.0
CONFIDENCE_WATCH_THRESHOLD=50.0
BACKTEST_LOOKBACK_YEARS=2
BACKTEST_OUTCOME_DAYS=5

# Alerts
DEFAULT_ALERT_CONFIDENCE_THRESHOLD=65.0

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app

# Frontend
# Local Vite dev uses /api with the proxy in apps/frontend/vite.config.ts.
# For Vercel, set VITE_API_BASE_URL to your Railway backend URL, for example:
# VITE_API_BASE_URL=https://your-backend.up.railway.app/api
VITE_API_BASE_URL=/api
